# Base URL of the HamMasir backend (Swagger: https://localhost:7220).
# A physical device must reach the LAN address of the development machine,
# for example: http://192.168.1.20:7220
EXPO_PUBLIC_API_BASE_URL=https://localhost:7220

# Optional: request timeout in milliseconds (default: 20000)
EXPO_PUBLIC_API_TIMEOUT_MS=20000

# Optional: Google Maps key for Android. Without it the map renders without
# tiles on Android (iOS uses Apple Maps by default).
GOOGLE_MAPS_API_KEY=

# Optional: Google Maps key for iOS (only needed when using PROVIDER_GOOGLE).
GOOGLE_MAPS_IOS_API_KEY=

# Optional Nominatim-compatible reverse lookup endpoint. For a public deployment,
# use your own proxy/provider to enforce the geocoding service's app-wide rate limit.
# The default public endpoint is for moderate, user-triggered lookups only.
EXPO_PUBLIC_REVERSE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
